# FUNGI: Extract top 20 genus list and filter
genustop20 <- final.community.phy %>%
  pivot_longer(cols = 12:97, names_to = "Genus", values_to = "abundance") %>% 
  group_by(Genus) %>% 
  summarise(total = sum(abundance)) %>% 
  slice_max(total, n = 20) %>%
  pull(Genus)
