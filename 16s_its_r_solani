# Procrustes ----------------------------------------------------------------
# clean
proc.16s.raw <- b.matrix.csv.16s
proc.its.raw <- b.matrix.csv.its
rownames(proc.16s.raw) <- gsub("^16S", "", rownames(proc.16s.raw))
colnames(proc.16s.raw) <- gsub("^16S", "", colnames(proc.16s.raw))
rownames(proc.its.raw) <- gsub("^ITS", "", rownames(proc.its.raw))
colnames(proc.its.raw) <- gsub("^ITS", "", colnames(proc.its.raw))

common_samples_proc <- intersect(rownames(proc.16s.raw), rownames(proc.its.raw))
proc.16s <- proc.16s.raw[common_samples_proc, common_samples_proc]
proc.its <- proc.its.raw[common_samples_proc, common_samples_proc]

# procrustes
bacteria.pcoa <- wcmdscale(proc.16s, eig = TRUE, add = "lingoes")
fungi.pcoa <- wcmdscale(proc.its, eig = TRUE, add = "lingoes")

# fit
concor <- procrustes(bacteria.pcoa, fungi.pcoa, scale = TRUE, symmetric = FALSE, choices=c(1,2))
summary(concor)

# visualization checks
par(mfrow=c(1,2))
plot(concor, kind = 1, main="Procrustes Errors")
plot(concor, kind = 2, main="Procrustes Fit")
par(mfrow=c(1,1))

# statistical significance
set.seed(17)
penvi.test <- protest(bacteria.pcoa, fungi.pcoa, scores = "sites", permutations = 999, choices=c(1,2))
penvi.test


