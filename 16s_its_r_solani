# Custom functions -------------------------------------------------------------
extract_mvabund_pvals <- function(anova_output) {
  tests <- anova_output$uni.test %>%
    as.data.frame() %>%
    tibble::rownames_to_column("variable") %>%
    pivot_longer(-variable, names_to = "species", values_to = "test")
  
  pvals <- anova_output$uni.p %>%
    as.data.frame() %>%
    tibble::rownames_to_column("variable") %>%
    pivot_longer(-variable, names_to = "species", values_to = "pval")
  
  inner_join(tests, pvals, by = c("variable", "species")) %>%
    dplyr::filter(!is.na(test))
}

